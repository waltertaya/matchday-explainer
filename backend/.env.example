# Copy to .env. Never commit credentials.
REDIS_URL=redis://localhost:6379/0
MATCH_STATE_TTL=86400
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional for archive browsing; required for IFAB RAG.
DB_URI=postgresql+psycopg://matchday:matchday@localhost:5432/matchday
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Azure route. Create these resources first.
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=match-events
EVENTHUB_CONSUMER_GROUP=start-builder
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER_NAME=match-events-checkpoints

# Paths default to directories next to the backend code.
# MATCH_DATA_DIR=/absolute/path/to/matches
# DATA_DIR=/absolute/path/to/data
# IFAB_DIR=/absolute/path/to/ifab
